# Environment Configuration for NVTop Webpage
# Copy this file to .env and customize values

# Authentication (REQUIRED - set secure passwords!)
AUTH_USER=nvtop-admin
AUTH_PASSWORD=your-secure-password-here  # CHANGE THIS!
AUTH_TOKEN_HEADER=X-Auth-Token

# Application
PORT=5000
CONFIG_PATH=instance/config.json
FLASK_ENV=production

# Optional: Set a custom AUTH_TOKEN for testing (not required in production)
# AUTH_TOKEN=test-token-for-testing-only-remove-in-production
