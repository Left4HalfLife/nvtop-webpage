# Environment Configuration for NVTop Webpage
# Copy this file to .env and customize values

# Copy this file to .env. Never commit .env.
NVTOP_AUTH_USER=nvtop-admin
NVTOP_AUTH_PASSWORD=replace-with-a-long-random-password
NVTOP_SECRET_KEY=replace-with-openssl-rand-hex-32

# Optional token for non-browser API clients.
# NVTOP_AUTH_TOKEN=replace-with-openssl-rand-base64-32
